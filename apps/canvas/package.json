{
	"name": "@meiye/canvas",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build --webpack && mkdir -p .next/standalone/apps/canvas/.next && cp -R .next/static .next/standalone/apps/canvas/.next/static",
		"check": "biome check app lib stores src/client src/kernel-host src/server src/shared next.config.ts && tsc --noEmit && tsc --project tsconfig.production.json --noEmit",
		"dev": "next dev --webpack --port 4200",
		"start": "sh -c 'PORT=${PORT:-4200} exec node .next/standalone/apps/canvas/server.js'",
		"test": "tsx --test 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit",
		"typecheck:production": "tsc --project tsconfig.production.json --noEmit",
		"verify:bundle": "node ../../scripts/pro-studio/canvas-bundle-budget.mjs .next"
	},
	"dependencies": {
		"@ant-design/nextjs-registry": "1.3.0",
		"@tanstack/react-query": "5.90.21",
		"@meiye/core": "workspace:*",
		"antd": "6.4.2",
		"clsx": "2.1.1",
		"fflate": "0.8.3",
		"localforage": "1.10.0",
		"lucide-react": "1.16.0",
		"next": "16.2.11",
		"pg": "^8.16.3",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tailwind-merge": "3.6.0",
		"zustand": "5.0.12",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.12",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.15.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2"
	}
}
