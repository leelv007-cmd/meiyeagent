{
	"name": "@meiye/canvas",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build --webpack && mkdir -p .next/standalone/apps/canvas/.next && cp -R .next/static .next/standalone/apps/canvas/.next/static",
		"check": "biome check app src next.config.ts && tsc --noEmit",
		"dev": "next dev --webpack --port 4200",
		"start": "sh -c 'PORT=${PORT:-4200} exec node .next/standalone/apps/canvas/server.js'",
		"test": "tsx --test 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@meiye/core": "workspace:*",
		"next": "16.2.10",
		"pg": "^8.16.3",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.12",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.15.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2"
	}
}
