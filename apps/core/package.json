{
  "name": "@meiye/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pro-studio": "./src/pro-studio/index.ts",
    "./pro-studio-runtime": "./src/pro-studio-runtime/index.ts",
    "./security": "./src/security/secret-hardening.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-runtime.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check": "tsc --noEmit",
    "assets:backfill-receipts": "tsx src/p1/model-supply/asset-receipt-backfill-cli-entry.ts",
    "assets:contract-minio": "bash scripts/run-s3-compatible-minio-contract.sh",
    "contentpackage:cutover": "tsx src/p1/operations/content-package-migration-cli-entry.ts",
    "cutover": "tsx src/p1/cutover/cli-entry.ts",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/job-worker.ts",
    "eval:redlines": "node --import tsx --test --test-concurrency=1 src/evals/redlines/parity.test.ts src/evals/redlines/promptfoo-provider.test.ts src/evals/redlines/redline-artifact.test.ts src/evals/skills/skill-eval.test.ts",
    "eval:redlines:artifact": "node --import tsx src/evals/redlines/write-recorded-artifact.ts",
    "eval:preference-memory": "node --import tsx --test --test-concurrency=1 src/evals/preference-memory/beauty-preference-memory.test.ts",
    "eval:preference-memory:artifact": "node --import tsx src/evals/preference-memory/write-recorded-artifact.ts",
    "eval:import": "node --import tsx src/p1/harness/langfuse-evalrun-importer-cli.ts",
    "langfuse:prompts:push": "node --import tsx src/p1/harness/langfuse-prompt-push-cli.ts",
    "langfuse:outbox:ops": "node --import tsx src/p1/harness/langfuse-outbox-ops-cli.ts",
    "eval:merchant-language": "node --import tsx --test --test-concurrency=1 src/evals/merchant-language/promptfoo-provider.test.ts",
    "start": "node --import tsx src/runtime-entry.ts api",
    "start:worker": "node --import tsx src/runtime-entry.ts worker",
    "test": "tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:postgres": "tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.14",
    "@ai-sdk/google": "^4.0.14",
    "@ai-sdk/mcp": "2.0.10",
    "@ai-sdk/openai-compatible": "3.0.7",
    "@aws-sdk/client-secrets-manager": "3.1085.0",
    "@dbos-inc/dbos-sdk": "4.23.6",
    "@meiye/contracts": "workspace:*",
    "ai": "^7.0.19",
    "fflate": "^0.8.2",
    "graphile-worker": "0.17.3",
    "pg": "^8.16.3",
    "pg-boss": "12.26.0",
    "sharp": "0.35.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "yaml": "2.9.0"
  }
}
