{
  "name": "@meiye/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./security": "./src/security/secret-hardening.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-runtime.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check": "tsc --noEmit",
    "assets:backfill-receipts": "tsx src/p1/model-supply/asset-receipt-backfill-cli-entry.ts",
    "plan-catalog:migrate": "tsx src/p1/admin-config/credit-plan-catalog-migration-cli-entry.ts",
    "assets:contract-minio": "bash scripts/run-s3-compatible-minio-contract.sh",
    "contentpackage:cutover": "tsx src/p1/operations/content-package-migration-cli-entry.ts",
    "cutover": "tsx src/p1/cutover/cli-entry.ts",
    "eval:redlines": "node --import tsx --test --test-concurrency=1 src/evals/redlines/parity.test.ts src/evals/redlines/promptfoo-provider.test.ts src/evals/redlines/redline-artifact.test.ts src/evals/skills/skill-eval.test.ts",
    "eval:redlines:artifact": "node --import tsx src/evals/redlines/write-recorded-artifact.ts",
    "eval:preference-memory": "node --import tsx --test --test-concurrency=1 src/evals/preference-memory/beauty-preference-memory.test.ts",
    "eval:fact-satisfaction": "node --import tsx --test --test-concurrency=1 src/p1/harness/fact-satisfaction.test.ts src/evals/fact-satisfaction/promptfoo-provider.test.ts",
    "eval:copywriting": "node --import tsx --test --test-concurrency=1 src/evals/copywriting/promptfoo-provider.test.ts",
    "eval:preference-memory:artifact": "node --import tsx src/evals/preference-memory/write-recorded-artifact.ts",
    "eval:import": "node --import tsx src/p1/harness/langfuse-evalrun-importer-cli.ts",
    "langfuse:prompt-long:live": "node --env-file-if-exists=../../.env --import tsx src/p1/harness/langfuse-prompt-live-acceptance-cli.ts",
    "langfuse:observability-axes:live": "node --env-file-if-exists=../../.env --import tsx src/p1/harness/langfuse-observability-live-acceptance-cli.ts",
    "harness:calibrate-bounds": "node --import tsx src/p1/harness/bounded-execution-calibration-cli.ts",
    "harness:collect-issue-255-live": "node --import tsx src/p1/harness/issue-255-live-collector-cli-entry.ts",
    "harness:reconcile-issue-255-live": "node --import tsx src/p1/harness/issue-255-live-reconciliation-cli-entry.ts",
    "harness:recover-issue-255-live-manifest": "node --import tsx src/p1/harness/issue-255-live-manifest-recovery-cli-entry.ts",
    "harness:record-issue-255": "node --import tsx src/p1/harness/issue-255-recorded-calibration-cli.ts",
    "langfuse:prompts:push": "node --import tsx src/p1/harness/langfuse-prompt-push-cli.ts",
    "langfuse:outbox:ops": "node --import tsx src/p1/harness/langfuse-outbox-ops-cli.ts",
    "eval:merchant-language": "node --import tsx --test --test-concurrency=1 src/evals/merchant-language/promptfoo-provider.test.ts",
    "eval:recipe-governance": "node --import tsx --test --test-concurrency=1 src/evals/recipe-governance/recipe-governance.test.ts",
    "eval:recipe-governance:artifact": "node --import tsx src/evals/recipe-governance/write-recorded-artifact.ts",
    "start": "node --import tsx src/runtime-entry.ts api",
    "start:worker": "node --import tsx src/runtime-entry.ts worker",
    "start:migrate": "node --import tsx src/runtime-entry.ts migrate",
    "dev": "node ../../scripts/dev/assert-process-profile.mjs && CORE_LOCAL_SUPERVISOR=1 tsx watch src/main.ts",
    "dev:worker": "node ../../scripts/dev/assert-process-profile.mjs && CORE_LOCAL_SUPERVISOR=1 tsx watch src/job-worker.ts",
    "test": "node ../../scripts/ci/run-core-suite.mjs --owner core",
    "test:postgres": "tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.14",
    "@ai-sdk/google": "^4.0.14",
    "@ai-sdk/mcp": "2.0.10",
    "@ai-sdk/openai-compatible": "3.0.7",
    "@aws-sdk/client-secrets-manager": "3.1085.0",
    "@dbos-inc/dbos-sdk": "4.23.6",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@langfuse/vercel-ai-sdk": "^5.9.1",
    "@meiye/contracts": "workspace:*",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^7.0.19",
    "fflate": "^0.8.2",
    "pg": "^8.16.3",
    "pg-boss": "12.26.0",
    "sharp": "0.35.3",
    "ws": "^8.21.1",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
