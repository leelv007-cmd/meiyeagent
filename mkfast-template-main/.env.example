# -----------------------------------------------------------------------------
# Base URL of the application
# -----------------------------------------------------------------------------
VITE_BASE_URL='http://localhost:3000'
# Required in staging/production. Use only service-binding or private-network;
# the value is a declaration and does not prove that network isolation exists.
INTERNAL_SERVICE_TRANSPORT='private-network'
CANVAS_SERVICE_URL='http://127.0.0.1:4200'
# Local fixture only. Production/staging must replace; startup rejects
# change-me-canvas, local-canvas-service-token, and the other weak placeholders
# listed in the monorepo root .env.example header.
CANVAS_SERVICE_TOKEN='change-me-canvas'
# Production must use an HTTPS edge-protected browser origin.
CANVAS_ORIGIN='http://localhost:4200'
PRO_STUDIO_OFFER_ID=''
PRO_STUDIO_PRICE_ID=''
PRO_STUDIO_AMOUNT_CENTS=''
PRO_STUDIO_CURRENCY=''
# Pro Studio is a durable one-time add-on; the only accepted value is one_time.
PRO_STUDIO_PAYMENT_TYPE='one_time'

# -----------------------------------------------------------------------------
# Cloudflare Token
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=''
CLOUDFLARE_API_TOKEN=''

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:5432/meiye'
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE='postgresql://postgres:postgres@127.0.0.1:5432/meiye'

# -----------------------------------------------------------------------------
# Auth (Better Auth)
# Generate a secret key: `pnpm dlx @better-auth/cli@latest secret`
# Production/staging refuses weak values such as better-auth-secret / change-me.
# Local fixture default (better-auth-secret) applies only under
# APP_ENV=development|e2e|test (or NODE_ENV=test).
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=''
# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# -----------------------------------------------------------------------------
# Payment Provider ('stripe' | 'creem' | '' to disable payment)
# -----------------------------------------------------------------------------
VITE_PAYMENT_PROVIDER=''
# Gate 0: keep public paid launch disabled until release evidence is approved.
VITE_PUBLIC_PAID_LAUNCH_ENABLED='false'
# D-123 中级 ¥1999/月 — single source for both the landing page and /pricing.
VITE_GROWTH_MONTHLY_AMOUNT_CENTS='199900'
VITE_GROWTH_YEARLY_AMOUNT_CENTS='399000'
VITE_LIFETIME_AMOUNT_CENTS='699000'

# -----------------------------------------------------------------------------
# Payment (Stripe)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=''
STRIPE_WEBHOOK_SECRET=''
VITE_STRIPE_PRICE_PRO_MONTHLY=''
VITE_STRIPE_PRICE_PRO_YEARLY=''
VITE_STRIPE_PRICE_LIFETIME=''

# -----------------------------------------------------------------------------
# Payment (Creem)
# -----------------------------------------------------------------------------
CREEM_DEBUG='true'
CREEM_API_KEY=''
CREEM_WEBHOOK_SECRET=''
VITE_CREEM_PRODUCT_PRO_MONTHLY=''
VITE_CREEM_PRODUCT_PRO_YEARLY=''
VITE_CREEM_PRODUCT_LIFETIME=''

# -----------------------------------------------------------------------------
# Mail (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=''

# -----------------------------------------------------------------------------
# Notification (Discord and Feishu)
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=''
FEISHU_WEBHOOK_URL=''

# -----------------------------------------------------------------------------
# Chatbot (Crisp Chat)
# -----------------------------------------------------------------------------
VITE_CRISP_WEBSITE_ID=''

# -----------------------------------------------------------------------------
# Analytics (Plausible)
# -----------------------------------------------------------------------------
VITE_PLAUSIBLE_SCRIPT=''
# -----------------------------------------------------------------------------
# Analytics (Google)
# -----------------------------------------------------------------------------
VITE_GOOGLE_ANALYTICS_ID=''
# -----------------------------------------------------------------------------
# Analytics (Umami)
# -----------------------------------------------------------------------------
VITE_UMAMI_SCRIPT=''
VITE_UMAMI_WEBSITE_ID=''
# -----------------------------------------------------------------------------
# Privacy-minimal telemetry version tuple
# -----------------------------------------------------------------------------
VITE_RELEASE_VERSION='local'
VITE_SCHEMA_REVISION='uiux-p1-v1'

# -----------------------------------------------------------------------------
# Fal
# -----------------------------------------------------------------------------
FAL_KEY=''
