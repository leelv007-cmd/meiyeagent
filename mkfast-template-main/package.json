{
  "name": "@meiye/web",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "e2e": "playwright test",
    "e2e:install": "playwright install",
    "e2e:ui": "playwright test --ui",
    "knip": "knip",
    "knip:production": "knip --production --include files",
    "check": "biome check",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "locale:sort": "tsx scripts/sort-locale-keys.ts",
    "locale:check": "tsx scripts/check-locale-keys.ts",
    "locale:compile": "tsx scripts/compile-locale.ts",
    "locale:compile:e2e": "tsx scripts/compile-locale.ts --dev",
    "test": "pnpm locale:compile && tsx --test $(find src scripts -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) ! -name '*.interaction.test.ts' ! -name '*.interaction.test.tsx')",
    "test:interaction": "pnpm locale:compile && vitest run",
    "test:interaction:watch": "vitest",
    "deploy": "pnpm run build && wrangler deploy",
    "postinstall": "pnpm run cf-typegen",
    "typecheck": "pnpm locale:compile && tsc --noEmit",
    "heroui:sync": "tsx scripts/sync-heroui-pro.ts",
    "email:dev": "pnpm run locale:compile && email dev --dir src/mail/templates --port 3333",
    "sync-github-secrets": "tsx scripts/sync-github-secrets.ts",
    "sync-worker-secrets": "wrangler secret bulk .env.production",
    "cf-typegen": "wrangler types --env-interface Env",
    "auth:schema:generate": "better-auth generate --yes --output src/db/auth.schema.ts",
    "auth:reset-password:offline": "tsx scripts/offline-reset-password.ts",
    "payment:audit-stripe-retirement": "tsx scripts/audit-stripe-retirement.ts",
    "payment:provision-waffo-subscriptions": "tsx scripts/provision-waffo-subscriptions.ts",
    "storage:audit-avatar-backfill": "tsx scripts/audit-avatar-backfill.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio:local": "drizzle-kit studio --config drizzle.config.local.ts",
    "db:studio:remote": "drizzle-kit studio --config drizzle.config.ts",
    "db:migrate:local": "drizzle-kit migrate --config drizzle.config.local.ts",
    "db:migrate:remote": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/api-key": "^1.6.23",
    "@cloudflare/vite-plugin": "^1.13.8",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@inlang/paraglide-js": "^2.20.0",
    "@meiye/contracts": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-aria/utils": "3.34.1",
    "@react-email/components": "^1.0.7",
    "@t3-oss/env-core": "^0.13.10",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-table": "^8.21.2",
    "@tiptap/core": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@waffo/pancake-ts": "0.16.1",
    "better-auth": "^1.6.23",
    "better-auth-harmony": "^1.3.2",
    "better-call": "1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crisp-sdk-web": "^1.0.27",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.5",
    "motion": "^12.42.2",
    "nuqs": "^2.8.8",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-aria-components": "1.19.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.2",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@better-auth/cli": "^1.4.12",
    "@biomejs/biome": "2.3.12",
    "@content-collections/core": "^0.13.1",
    "@content-collections/vite": "^0.2.8",
    "@playwright/test": "^1.61.0",
    "@react-email/preview-server": "5.2.5",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.9",
    "fflate": "^0.8.2",
    "jsdom": "^29.1.1",
    "knip": "^5.84.1",
    "react-email": "5.2.5",
    "shadcn": "^4.13.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.10",
    "wrangler": "^4.84.1"
  }
}
