{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meiye-web-waffo-test",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  // This version is only for Waffo Test. It has no production custom-domain route.
  "preview_urls": true,
  "workers_dev": false,
  "vars": {
    "APP_ENV": "e2e",
    "CORE_SERVICE_URL": "https://core-test.tqai.uk",
    "INTERNAL_SERVICE_TRANSPORT": "private-network",
    "WAFFO_ENVIRONMENT": "test"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3d191e95f5f940ef8aaee857c6f38b35"
    }
  ]
}
