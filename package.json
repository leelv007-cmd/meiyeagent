{
  "name": "legacy-web-repo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@types/node": "^22.10.2"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "node scripts/uiux/check-gates.mjs",
    "contentpackage:cutover": "pnpm --filter @meiye/core contentpackage:cutover",
    "dev": "node --env-file-if-exists=.env.example --env-file-if-exists=.env scripts/dev/start-stack.mjs",
    "dev:all": "pnpm -r --parallel --filter @meiye/web --filter @meiye/core run \"/^dev(:worker)?$/\"",
    "dev:live": "pnpm dev",
    "dev:smoke": "node --env-file-if-exists=.env.example --env-file-if-exists=.env scripts/dev/smoke-stack.mjs",
    "dev:recorded": "APP_ENV=development MODEL_EXECUTION_MODE=recorded node --env-file-if-exists=.env --run=dev:all",
    "dev:worker": "pnpm --filter @meiye/core dev:worker",
    "e2e": "pnpm --filter @meiye/web e2e",
    "eval:import": "pnpm --filter @meiye/core eval:import",
    "eval:copywriting": "pnpm --filter @meiye/core eval:copywriting",
    "eval:copywriting:promptfoo": "node scripts/evals/run-promptfoo.mjs copywriting",
    "eval:copywriting:promptfoo:control": "node scripts/evals/run-promptfoo.mjs copywriting --control",
    "eval:fact-satisfaction": "pnpm --filter @meiye/core eval:fact-satisfaction",
    "eval:fact-satisfaction:promptfoo": "node scripts/evals/run-promptfoo.mjs fact-satisfaction",
    "eval:fact-satisfaction:promptfoo:control": "node scripts/evals/run-promptfoo.mjs fact-satisfaction --control",
    "eval:merchant-language": "pnpm --filter @meiye/core eval:merchant-language",
    "eval:merchant-language:promptfoo": "node scripts/evals/run-promptfoo.mjs merchant-language",
    "eval:merchant-language:promptfoo:control": "node scripts/evals/run-promptfoo.mjs merchant-language --control",
    "eval:preference-memory": "pnpm --filter @meiye/core eval:preference-memory",
    "eval:redlines": "pnpm --filter @meiye/core eval:redlines",
    "eval:redlines:promptfoo": "node scripts/evals/run-promptfoo.mjs redlines",
    "eval:redlines:promptfoo:control": "node scripts/evals/run-promptfoo.mjs redlines --control",
    "n2:recovery:drill": "node scripts/recovery/production-recovery-cli.mjs drill",
    "n2:recovery:verify": "node scripts/recovery/production-recovery-cli.mjs verify",
    "ops:issue-253-readiness": "node scripts/ops/issue-253-readiness.mjs",
    "ops:verify-wrangler": "node scripts/ops/verify-wrangler-config.mjs",
    "ops:issue257:delete-window": "node scripts/ops/issue-257-delete-window.mjs",
    "security:production-boundary": "node scripts/production-network-boundary-gate.mjs",
    "security:production-boundary:test": "node --test scripts/production-network-boundary-gate.test.mjs",
    "test": "pnpm -r --if-present test && node --test scripts/ci/*.test.mjs scripts/dev/*.test.mjs scripts/uiux/*.test.mjs scripts/recovery/*.test.mjs scripts/ops/*.test.mjs scripts/polotno-retirement-gate.test.mjs",
    "test:journeys": "pnpm --filter @meiye/core exec tsx --test ../../tests/v31-artifact-composer-sse-workbench.journey.test.ts",
    "typecheck:journeys": "pnpm --filter @meiye/core exec tsc -p ../../tsconfig.journeys.json",
    "typecheck": "bash scripts/ci/run-root-typecheck.sh",
    "uiux:baseline": "node scripts/uiux/baseline-manifest.mjs --pre-cutover 0cba260",
    "uiux:bundle-check": "node scripts/uiux/bundle-budget.mjs",
    "uiux:cutover": "pnpm --filter @meiye/core cutover",
    "uiux:secret-scan": "node scripts/uiux/secret-scan.mjs"
  }
}
