+  private updateDouyinPublishPolling(
+    input: DouyinPublishJob,
+    at: string,
+    source: 'submit' | 'manual' | 'poll' | 'callback'
+  ): DouyinPublishJob {
+    const job = structuredClone(input);
+    if (
+      job.status === 'published' ||
+      job.status === 'failed' ||
+      job.status === 'manual_required'
