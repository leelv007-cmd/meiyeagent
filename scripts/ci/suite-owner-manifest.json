          "references": [
            {
              "path": ".github/workflows/core-quality.yml",
              "contains": "run: pnpm --filter @meiye/core test"
            },
            {
              "path": "apps/core/package.json",
              "contains": "node ../../scripts/ci/run-core-suite.mjs --owner core"
            }
          ]
        }
      ]
    },
