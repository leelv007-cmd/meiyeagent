              "category": "contract",
              "run": "node --test scripts/ci/*.test.mjs scripts/dev/*.test.mjs scripts/uiux/*.test.mjs scripts/recovery/*.test.mjs scripts/ops/*.test.mjs scripts/polotno-retirement-gate.test.mjs"
            }
          ],
          "references": [
            {
              "path": "scripts/ci/run-root-required-quality.sh",
              "contains": "run_required_gate root-test.log pnpm test"
            },
            {
              "path": "package.json",
              "contains": "node --test scripts/ci/*.test.mjs scripts/dev/*.test.mjs scripts/uiux/*.test.mjs scripts/recovery/*.test.mjs scripts/ops/*.test.mjs scripts/polotno-retirement-gate.test.mjs"
            }
          ]
        },
        {
          "id": "web-interaction-command",
          "run": "pnpm --filter @meiye/web test:interaction",
          "references": [
            {
              "path": "scripts/ci/run-root-required-quality.sh",
              "contains": "run_required_gate web-interaction-test.log pnpm --filter @meiye/web test:interaction"
            },
            {
              "path": "mkfast-template-main/package.json",
              "contains": "\"test:interaction\": \"pnpm locale:compile && vitest run\""
            }
          ]
        }
      ]
    },
